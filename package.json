{
  "name": "inquiry-reception-workbench",
  "version": "0.3.21",
  "private": true,
  "description": "Customer reception desktop workbench",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juccistar/reception-workbench.git"
  },
  "main": "artifacts/app/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "test:tools": "node --test scripts/tests/*.test.mjs",
    "test": "npm run test:backend && npm run test:ui && npm run test:tools",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "package": "node scripts/package.mjs",
    "package:release": "node scripts/package.mjs --installer --update-url https://github.com/juccistar/reception-workbench-releases"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "lucide-react": "^1.70.0",
    "puppeteer": "24.38.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "whatsapp-web.js": "1.34.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
